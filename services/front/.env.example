# Front de PoleBet: variables opcionales para desarrollo local.
# Copia este archivo a `.env` dentro de services/front/ si necesitas cambiar algo.
# En Docker estas URLs las inyecta docker-compose como build args.

# ---- URLs de los backends ----
# Si no se definen, el front usa el proxy de Vite (/api/pagos y /api/motor),
# que es lo recomendado en desarrollo porque la cookie de sesion viaja sola.
# VITE_PAGOS_URL=http://localhost:8000
# VITE_MOTOR_URL=http://localhost:8080
# VITE_MOTOR_WS_URL=ws://localhost:8080

# ---- HU-05 ----
# true = muestra en /carrera la latencia de cada mensaje de posiciones (RNF-04).
VITE_SHOW_LATENCY=false

# ---- Sesion simulada (mientras no exista el login de HU-02) ----
# player | admin | ninguno. Con "ninguno" la app arranca sin sesion.
VITE_ROL_SIMULADO=player
